# Copy to src/backend/.env and fill in. Never commit the real .env.

ENVIRONMENT=development

# Same project URL and anon key the frontend uses.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only. Bypasses Row Level Security. Never put this in the frontend
# or in any NEXT_PUBLIC_ variable. Leave blank unless an admin task needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated exact origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Optional regex for origins that change per deploy (Vercel preview URLs).
# Example: ^https://husky-marketplace-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=
