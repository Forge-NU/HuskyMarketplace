# Copy to .env.local (git-ignored) and fill in from Supabase:
# Project Settings -> API (or the "Connect" button).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Never put the service_role key in the frontend.

# URL of the FastAPI backend (see src/backend/README.md)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Device verification. Shared Supabase enforces it (see supabase/templates/README.md),
# so this must be true or every page fails to load data after sign-in.
DEVICE_VERIFICATION_ENABLED=true
